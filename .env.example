# Copy this file to .env (or inject these variables into your container runtime)
# The server expects a base64-encoded Azure DevOps PAT for PAT auth mode.
# Example:
#   printf 'user@example.com:YOUR_PAT' | base64
#   # paste the output here
PERSONAL_ACCESS_TOKEN=<base64-encoded-pat>

# Optional: override the default organization and auth mode when running locally.
ADO_ORG=<your-azure-devops-organization>
AUTH_MODE=pat
LOG_LEVEL=info
